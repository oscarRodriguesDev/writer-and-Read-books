// Schema — book-writer-and-reader
// Nota: SQLite não suporta enums Prisma. Campos de enumeração são String
// e validados com Zod em src/lib/validators/.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Obra {
  id           String   @id @default(cuid())
  titulo       String
  subtitulo    String?
  genero       String?
  subgenero    String?
  tema         String?
  publicoAlvo  String?
  descricao    String?
  // Dono da obra (usuário). Nullable para não quebrar dados órfãos na
  // migração; o código sempre preenche com o usuário da sessão.
  usuarioId    String?
  // PLANEJAMENTO | ESCRITA | REVISAO | CONCLUIDA
  status       String   @default("PLANEJAMENTO")
  arquivada    Boolean  @default(false)
  // Metadados de publicação
  isbn         String?  @unique
  isbn13       String?  @unique
  idioma       String   @default("pt-BR")
  dataPublicacao DateTime?
  editora      String?
  edicao       String?  @default("1")
  direitosAutorais String?
  capaUrl      String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario         Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  esqueleto       Esqueleto?
  capitulos       Capitulo[]
  atos            Ato[]
  personagens     Personagem[]
  ambientes       Ambiente[]
  artefatos       Artefato[]
  eventos         EventoLinhaDoTempo[]
  analises        AnaliseIA[]
  canonInfos      CanonInfo[]
  regras          RegraObra[]
  importacoes     ImportacaoArquivo[]
  autores         AutorObra[]
  categorias      CategoriaObra[]
  palavrasChave   PalavraChaveObra[]

  @@index([usuarioId])
}

model Esqueleto {
  id                        String  @id @default(cuid())
  obraId                    String  @unique
  premissa                  String?
  conflitoPrincipal         String?
  conflitosSecundarios      String?
  objetivoProtagonista      String?
  transformacaoProtagonista String?
  eventosPrincipais         String?
  pontosVirada              String?
  climax                    String?
  desfecho                  String?

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)
}

model Capitulo {
  id             String   @id @default(cuid())
  obraId         String
  titulo         String
  objetivo       String?
  ordemEscrita   Int
  ordemNarrativa Int?
  // Ato narrativo ao qual o capítulo pertence (agrupamento visual; a
  // ordemNarrativa global continua sendo a fonte de ordenação da obra)
  atoId          String?
  ordemDentroDoAto Int?
  // PLANEJADO | RASCUNHO | REVISAO | FINAL
  status         String   @default("PLANEJADO")
  // Imagem ilustrativa do capítulo (caminho público, ex.: /uploads/capitulo/x.jpg)
  imagemUrl      String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  obra    Obra      @relation(fields: [obraId], references: [id], onDelete: Cascade)
  ato     Ato?      @relation(fields: [atoId], references: [id], onDelete: SetNull)
  partes  Parte[]
  achados AchadoIA[] @relation("AchadoCapitulo")
  eventos EventoLinhaDoTempo[]

  @@unique([obraId, ordemNarrativa])
  @@index([obraId, ordemNarrativa])
  @@index([atoId, ordemDentroDoAto])
}

model Ato {
  id           String   @id @default(cuid())
  obraId       String
  titulo       String
  sinopse      String?
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  obra      Obra       @relation(fields: [obraId], references: [id], onDelete: Cascade)
  capitulos Capitulo[]

  @@unique([obraId, ordem])
  @@index([obraId])
}

model Parte {
  id         String @id @default(cuid())
  capituloId String
  // INICIO | MEIO | FIM
  tipo       String

  capitulo Capitulo @relation(fields: [capituloId], references: [id], onDelete: Cascade)
  cenas    Cena[]
  achados  AchadoIA[] @relation("AchadoParte")

  @@unique([capituloId, tipo])
}

model Cena {
  id           String   @id @default(cuid())
  parteId      String
  // 1..N — posição da cena dentro da parte (a estrutura original cria 3).
  ordem        Int      @default(1)
  // Rótulo herdado (INICIO | MEIO | FIM) das cenas da estrutura original;
  // cenas adicionadas depois recebem "CENA" — o rótulo exibido vem de `ordem`.
  tipo         String
  titulo       String?
  conteudo     String   @default("")
  objetivo     String?
  atualizadoEm DateTime @updatedAt

  parte       Parte            @relation(fields: [parteId], references: [id], onDelete: Cascade)
  personagens CenaPersonagem[]
  ambientes   CenaAmbiente[]
  achados     AchadoIA[]       @relation("AchadoCena")
  versoes     VersaoCena[]

  @@unique([parteId, ordem])
}

model Personagem {
  id            String   @id @default(cuid())
  obraId        String
  nome          String
  // PROTAGONISTA | ANTAGONISTA | SECUNDARIO | COADJUVANTE
  papel         String   @default("SECUNDARIO")
  // Imagem representativa (caminho público)
  imagemUrl     String?
  fisico        String?
  psicologico   String?
  historia      String?
  comportamento String?
  // O que esse personagem quer alcançar na história
  objetivo      String?
  // Arco narrativo do personagem (ex.: "Herói", "Redenção", "Queda")
  arco          String?
  // Descrição opcional do arco (transformação, jornada)
  arcoDescricao String?
  observacoes   String?
  criadoEm      DateTime @default(now())

  obra            Obra                 @relation(fields: [obraId], references: [id], onDelete: Cascade)
  cenas           CenaPersonagem[]
  relacoesOrigem  RelacaoPersonagem[]  @relation("RelacaoOrigem")
  relacoesDestino RelacaoPersonagem[]  @relation("RelacaoDestino")

  @@index([obraId])
}

model RelacaoPersonagem {
  id         String  @id @default(cuid())
  origemId   String
  destinoId  String
  tipo       String
  descricao  String?

  origem  Personagem @relation("RelacaoOrigem", fields: [origemId], references: [id], onDelete: Cascade)
  destino Personagem @relation("RelacaoDestino", fields: [destinoId], references: [id], onDelete: Cascade)

  @@index([origemId])
  @@index([destinoId])
}

model Ambiente {
  id                    String  @id @default(cuid())
  obraId                String
  nome                  String
  // Imagem representativa (caminho público)
  imagemUrl             String?
  localizacao           String?
  descricao             String?
  epoca                 String?
  importanciaNarrativa  String?

  obra    Obra           @relation(fields: [obraId], references: [id], onDelete: Cascade)
  cenas   CenaAmbiente[]

  @@index([obraId])
}

model Artefato {
  id          String   @id @default(cuid())
  obraId      String
  nome        String
  // Imagem representativa (caminho público)
  imagemUrl   String?
  descricao   String?
  historia    String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
}

model EventoLinhaDoTempo {
  id               String  @id @default(cuid())
  obraId           String
  titulo           String
  descricao        String?
  // ANO | MES | DIA | HORA | INDEFINIDO
  escalaTemporal   String  @default("INDEFINIDO")
  dataInicio       Json?
  dataFim          Json?
  ordemCronologica Int
  capituloId       String?

  obra     Obra      @relation(fields: [obraId], references: [id], onDelete: Cascade)
  capitulo Capitulo? @relation(fields: [capituloId], references: [id], onDelete: SetNull)

  @@unique([obraId, ordemCronologica])
}

model CenaPersonagem {
  cenaId       String
  personagemId String

  cena       Cena       @relation(fields: [cenaId], references: [id], onDelete: Cascade)
  personagem Personagem @relation(fields: [personagemId], references: [id], onDelete: Cascade)

  @@id([cenaId, personagemId])
}

model CenaAmbiente {
  cenaId     String
  ambienteId String

  cena     Cena     @relation(fields: [cenaId], references: [id], onDelete: Cascade)
  ambiente Ambiente @relation(fields: [ambienteId], references: [id], onDelete: Cascade)

  @@id([cenaId, ambienteId])
}

model CanonInfo {
  id             String   @id @default(cuid())
  obraId         String
  categoria      String
  titulo         String
  conteudo       String
  ehSegredoAutor Boolean  @default(false)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
}

model RegraObra {
  id        String  @id @default(cuid())
  obraId    String
  descricao String
  ativa     Boolean @default(true)

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)
}

model AnaliseIA {
  id       String   @id @default(cuid())
  obraId   String
  // OBRA | CAPITULO | CENA | TRECHO
  escopo   String
  modeloIA String?
  resumo   String?
  // PENDENTE | EM_ANDAMENTO | CONCLUIDA | ERRO
  status   String   @default("PENDENTE")
  criadoEm DateTime @default(now())

  obra    Obra      @relation(fields: [obraId], references: [id], onDelete: Cascade)
  achados AchadoIA[]
}

model AchadoIA {
  id                 String    @id @default(cuid())
  analiseId          String
  // BAIXA | MEDIA | ALTA | CRITICA
  severidade         String
  // CONTINUIDADE | CRONOLOGIA | PERSONAGEM | AMBIENTE | CAUSALIDADE | ESTRUTURA | CONHECIMENTO | CANON | CONTRADICAO
  categoria          String
  trecho             String
  evidencia          String?
  explicacao         String
  sugestao           String?
  capituloId         String?
  parteId            String?
  cenaId             String?
  offsetInicio       Int?
  offsetFim          Int?
  // NOVO | EM_ANALISE | RESOLVIDO | IGNORADO | INTENCIONAL
  status             String    @default("NOVO")
  justificativaAutor String?
  resolvidoEm        DateTime?
  criadoEm           DateTime  @default(now())

  analise  AnaliseIA @relation(fields: [analiseId], references: [id], onDelete: Cascade)
  capitulo Capitulo? @relation("AchadoCapitulo", fields: [capituloId], references: [id], onDelete: SetNull)
  parte    Parte?    @relation("AchadoParte", fields: [parteId], references: [id], onDelete: SetNull)
  cena     Cena?     @relation("AchadoCena", fields: [cenaId], references: [id], onDelete: SetNull)

  @@index([analiseId, severidade])
  @@index([status])
}

model VersaoCena {
  id       String   @id @default(cuid())
  cenaId   String
  conteudo String
  criadoEm DateTime @default(now())

  cena Cena @relation(fields: [cenaId], references: [id], onDelete: Cascade)

  @@index([cenaId, criadoEm])
}

model ImportacaoArquivo {
  id                String   @id @default(cuid())
  obraId            String
  nomeArquivo       String
  // TXT | PDF
  formato           String
  tamanhoBytes      Int
  conteudoImportado String?
  mapeadoParaObra   Boolean  @default(false)
  criadoEm          DateTime @default(now())

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)
}

// ===== NOVOS MODELS PARA METADADOS DE PUBLICAÇÃO =====

model Autor {
  id        String   @id @default(cuid())
  nome      String
  bio       String?
  fotoUrl   String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  obras     AutorObra[]
}

model AutorObra {
  id        String   @id @default(cuid())
  obraId    String
  autorId   String
  // AUTOR | COAUTOR | ORGANIZADOR | TRADUTOR | ILUSTRADOR | PREFACIADOR | POSFACIADOR
  papel     String   @default("AUTOR")
  ordem     Int      @default(0)
  obra      Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  autor     Autor    @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@unique([obraId, autorId])
  @@index([obraId])
  @@index([autorId])
}

model Categoria {
  id        String   @id @default(cuid())
  codigo    String   @unique // Ex: "FIC000000" (BISAC)
  nome      String
  paiId     String?
  pai       Categoria?  @relation("Subcategorias", fields: [paiId], references: [id])
  filhos    Categoria[] @relation("Subcategorias")
  obras     CategoriaObra[]

  @@index([paiId])
}

model CategoriaObra {
  id          String   @id @default(cuid())
  obraId      String
  categoriaId String
  principal   Boolean  @default(false)
  obra        Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([obraId, categoriaId])
  @@index([obraId])
  @@index([categoriaId])
}

model PalavraChaveObra {
  id        String @id @default(cuid())
  obraId    String
  termo     String
  obra      Obra   @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@unique([obraId, termo])
  @@index([obraId])
}

// ===== AUTENTICAÇÃO =====

model Usuario {
  id                String    @id @default(cuid())
  nome              String
  idade             Int?
  // Gêneros literários que o autor escreve (array JSON validado por Zod —
  // SQLite não suporta String[] no Prisma)
  generosLiterarios Json?
  nomeAutor         String? // Pseudônimo para publicações
  fotoUrl           String?
  username          String    @unique // normalizado em minúsculas
  senhaHash         String
  email             String    @unique // normalizado em minúsculas
  telefone          String?
  bio               String?
  site              String?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  obras Obra[] // obras da qual este usuário é dono
}
